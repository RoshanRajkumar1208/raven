{
  "swagger": "2.0",
  "info": {"title": "RAVEN Demo Shop API (Swagger 2.0)", "version": "1.0.0"},
  "host": "127.0.0.1:8088",
  "basePath": "/api/v1",
  "schemes": ["http"],
  "consumes": ["application/json"],
  "produces": ["application/json"],
  "securityDefinitions": {
    "bearerAuth": {"type": "apiKey", "name": "Authorization", "in": "header"}
  },
  "security": [{"bearerAuth": []}],
  "paths": {
    "/health": {
      "get": {"summary": "Health check", "security": [], "responses": {"200": {"description": "OK"}}}
    },
    "/products": {
      "get": {
        "summary": "List products",
        "security": [],
        "parameters": [
          {"name": "category", "in": "query", "type": "string", "enum": ["books", "games", "music"]},
          {"name": "limit", "in": "query", "type": "integer", "minimum": 1, "maximum": 100, "x-example": 10}
        ],
        "responses": {"200": {"description": "Product list"}, "400": {"description": "Invalid input"}}
      }
    },
    "/users": {
      "get": {"summary": "List users", "responses": {"200": {"description": "User list"}, "401": {"description": "Not logged in"}}}
    },
    "/users/{id}": {
      "get": {
        "summary": "Get one user",
        "parameters": [{"name": "id", "in": "path", "required": true, "type": "integer", "minimum": 1, "maximum": 10000, "x-example": 1}],
        "responses": {"200": {"description": "The user"}, "404": {"description": "Not found"}}
      }
    },
    "/orders": {
      "get": {"summary": "List orders", "responses": {"200": {"description": "Order list"}, "401": {"description": "Not logged in"}}},
      "post": {
        "summary": "Create an order",
        "parameters": [{
          "name": "order", "in": "body", "required": true,
          "schema": {"$ref": "#/definitions/NewOrder"}
        }],
        "responses": {"201": {"description": "Created"}, "400": {"description": "Invalid input"}}
      }
    },
    "/login": {
      "post": {
        "summary": "Log in",
        "security": [],
        "parameters": [{
          "name": "credentials", "in": "body", "required": true,
          "schema": {
            "type": "object",
            "required": ["username", "password"],
            "properties": {
              "username": {"type": "string", "maxLength": 50, "example": "demo"},
              "password": {"type": "string", "format": "password", "example": "demo-password"}
            }
          }
        }],
        "responses": {"200": {"description": "Logged in"}, "401": {"description": "Wrong credentials"}}
      }
    },
    "/reports/daily": {
      "get": {"summary": "Daily report", "responses": {"200": {"description": "Report"}}}
    }
  },
  "definitions": {
    "NewOrder": {
      "type": "object",
      "required": ["product_id", "quantity"],
      "properties": {
        "product_id": {"type": "integer", "minimum": 1, "example": 7},
        "quantity": {"type": "integer", "minimum": 1, "maximum": 20, "example": 1}
      }
    }
  }
}
